# Application Settings
APP_NAME=FluxEngine
DEBUG=False
HOST=0.0.0.0
PORT=8000

# Security Settings
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-this-before-deploying
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Settings
DATABASE_PATH=./data/fluxengine.db

# CORS Settings (JSON array — set to your actual frontend domain in production)
ALLOWED_ORIGINS=["http://localhost:3000"]
